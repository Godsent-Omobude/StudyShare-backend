datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  username  String   @unique
  email     String?  @unique
  matricNumber String?
  password  String
  role      String   @default("student")
  profilePicture String?
  showUsernameOnMaterials Boolean @default(true)
  theme     String   @default("system")
  accentColor String  @default("blue")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?
  tokenVersion Int @default(0)
  emailVerified Boolean @default(false)
  verificationCodeHash String?
  verificationCodeExpiresAt DateTime?
  verificationAttempts Int @default(0)
  verificationCodeSentAt DateTime?
  currentStreak Int @default(0)
  longestStreak Int @default(0)
  lastStudyDate DateTime?
  totalStudyDays Int @default(0)
  // Hash of the card-id order from this user's most recent "Study All"
  // shuffle. Used purely so a freshly generated shuffle can be checked
  // against it and re-rolled on the rare collision — no AI involved.
  lastShuffleHash String?

  // --- Push notifications (Firebase Cloud Messaging) ---
  // Per-category opt-in/out. Read by pushNotificationService before it
  // ever sends a push for a given notification type — a category set to
  // false here means that type of notification simply never triggers a
  // push for this user (in-app notifications/socket events are unaffected).
  notifyCircleMessages     Boolean @default(true)
  notifyCircleInvitations  Boolean @default(true)
  notifyMentions           Boolean @default(true)
  notifyCircleActivity     Boolean @default(true)
  notifyFlashcardActivity  Boolean @default(true)
  notifyAccountSecurity    Boolean @default(true)
  notifyAnnouncements      Boolean @default(true)

  pushRegistrations PushRegistration[]

  // --- Copyright moderation / account enforcement ---
  // Temporary hold short of full termination. A suspended user can still
  // log in (so they see why) but protect() blocks everything else while
  // suspendedUntil is in the future.
  suspendedAt      DateTime?
  suspendedUntil   DateTime?
  suspendedReason  String?
  // Permanent enforcement action. Distinct from a normal delete so the
  // account/audit trail survives even though the user can no longer use it.
  terminatedAt     DateTime?
  terminatedReason String?
  copyrightWarnings Int @default(0)

  // --- Copyright Policy acceptance (mandatory, gates login) ---
  // Null/blank until the user explicitly accepts. copyrightPolicyVersion
  // records *which* version they agreed to, so a future material update to
  // the policy can force re-acceptance by bumping CURRENT_COPYRIGHT_POLICY_VERSION
  // (see backend/utils/legalPolicy.js) without needing a new DB column.
  copyrightPolicyAcceptedAt DateTime?
  copyrightPolicyVersion    String?

  files     File[]
  flashcardSets FlashcardSet[]

  copyrightReportsFiled    CopyrightReport[]   @relation("ReportComplainant")
  copyrightReportsReviewed CopyrightReport[]   @relation("ReportReviewer")
  copyrightDisputesFiled   CopyrightDispute[]  @relation("DisputeUploader")
  copyrightDisputesReviewed CopyrightDispute[] @relation("DisputeReviewer")
  copyrightNotesAuthored   CopyrightNote[]     @relation("NoteAuthor")
  copyrightAuditActions    CopyrightAuditLog[] @relation("AuditAdmin")
  copyrightAuditTargeted   CopyrightAuditLog[] @relation("AuditTargetUser")
  filesReviewed            File[]              @relation("FileCopyrightReviewer")

  ownedCircles          StudyCircle[]       @relation("CircleOwner")
  circleMemberships     CircleMember[]
  circleInvitesSent     CircleInvite[]      @relation("CircleInvitesSent")
  circleInvitesReceived CircleInvite[]      @relation("CircleInvitesReceived")
  circleJoinRequests    CircleJoinRequest[]
  circleMessages        CircleMessage[]
  circleFilesShared     CircleSharedFile[] @relation("CircleFilesShared")
  deletedCircleMessages CircleMessage[]    @relation("CircleMessageDeletedBy")
  notificationsReceived Notification[]      @relation("NotificationRecipient")
  notificationsCreated Notification[]      @relation("NotificationActor")
  pinnedCircleMessages CirclePinnedMessage[]

  studySessionsCreated StudySession[]       @relation("StudySessionCreator")
  studySessionRsvps    StudySessionRSVP[]   @relation("StudySessionRSVPUser")
  circleNotesCreated   CircleNote[]         @relation("CircleNoteCreator")
  circleNotesUpdated   CircleNote[]         @relation("CircleNoteUpdater")
}

model File {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  courseCode   String?
  type         String   // 'Material' or 'Past Question'
  filename     String
  filepath     String
  mimetype     String
  uploaderName String
  downloads    Int      @default(0)

  // Copyright screening metadata. Extracted document text is never stored.
  // These are the original upload-time-only fields (kept for backward
  // compatibility with existing rows/queries).
  copyrightConfirmedAt DateTime?
  copyrightConfirmationVersion String?
  copyrightScanStatus String @default("APPROVED")
  copyrightRiskScore Int @default(0)
  copyrightScanCheckedAt DateTime?
  contentHash String?

  // --- Copyright moderation (full lifecycle) ---
  // copyrightStatus is the canonical moderation state used by the admin
  // review queue and access control. copyrightScanStatus above remains as
  // the raw upload-time scan result for reference/back-compat.
  // Canonical DB default is CLEARED (see the migration's backfill comment —
  // existing/unspecified rows should not vanish from publication). Every
  // real upload path (routes/files.js) sets this field explicitly to the
  // scanner's resolved status, so this default only matters for a row
  // created without going through that path.
  copyrightStatus       CopyrightStatus @default(CLEARED)
  copyrightRisk         CopyrightRisk?
  copyrightScore        Int             @default(0)
  // True only when the automated scan itself crashed (extraction error, DB
  // hiccup, etc) and the file was held for manual review without ever being
  // scored. Lets the admin UI show "scan failed" instead of a numeric score,
  // which would otherwise look identical to a genuine 0/100 (no risk found).
  copyrightScanFailed   Boolean         @default(false)
  copyrightCheckedAt    DateTime?

  // Near-duplicate detection (MinHash-style signature over shingled,
  // normalised extracted text — never the raw text itself).
  textFingerprint       Int[]           @default([])
  similarityScore       Float           @default(0)
  duplicateOfId         Int?
  duplicateOf           File?           @relation("FileDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates            File[]          @relation("FileDuplicates")

  webMatchFound         Boolean         @default(false)
  sourceReferences       Json?          // [{ url, domain, phrase }], capped small list
  reviewRequired         Boolean        @default(false)
  reviewReason           String?
  reviewedByUserId        Int?
  reviewedByUser          User?         @relation("FileCopyrightReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt              DateTime?

  restrictionReason       String?
  removalReason           String?
  uploaderNotifiedAt      DateTime?
  reportCount             Int           @default(0)
  internalNotesCount      Int           @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relationship to User
  uploadedBy   Int
  user         User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  circleShares CircleSharedFile[]

  copyrightReports  CopyrightReport[]
  copyrightDisputes CopyrightDispute[]
  copyrightNotes    CopyrightNote[]

  @@index([contentHash])
  @@index([copyrightScanStatus])
  @@index([copyrightStatus])
  @@index([copyrightRisk])
  @@index([duplicateOfId])
}

enum CopyrightStatus {
  PENDING
  CLEARED
  REVIEW_REQUIRED
  RESTRICTED
  REMOVED
  REJECTED
}

enum CopyrightRisk {
  LOW
  MEDIUM
  HIGH
}

enum CopyrightReportStatus {
  PENDING
  UNDER_REVIEW
  ACTION_TAKEN
  REJECTED
  RESOLVED
  CLOSED
}

enum CopyrightReportOutcome {
  LEGITIMATE
  UNFOUNDED
  INSUFFICIENT_INFORMATION
  FALSE_OR_MISLEADING
}

enum CopyrightDisputeStatus {
  PENDING
  UNDER_REVIEW
  UPHELD
  RESTORED
  CLOSED
}

// How a CopyrightReport (case) came to exist — through the in-app report
// form, or typed in by an admin for a complaint that arrived elsewhere
// (email, postal notice, etc).
enum CopyrightCaseSource {
  USER_SUBMITTED
  MANUAL
}

// A complaint that a specific File infringes someone's copyright — either
// a user-submitted complaint, or a case an admin created by hand. Not tied
// 1:1 to a logged-in account — complainantUserId is set only when the
// reporter was authenticated.
//
// fileId is nullable and SetNull-on-delete (not Cascade): a case record is
// a compliance/audit artifact and must survive the underlying File being
// removed. fileTitleSnapshot/fileFilenameSnapshot/fileHashSnapshot and the
// uploader* snapshot fields are captured once at creation time precisely
// so the case stays fully readable even after the file — or the uploader's
// account — is gone. uploaderId is a plain int (no FK) for the same reason.
model CopyrightReport {
  id         Int                 @id @default(autoincrement())
  caseNumber String              @unique // e.g. "CR-2026-0001", auto-generated, sequential per year
  source     CopyrightCaseSource @default(USER_SUBMITTED)

  fileId Int?
  file   File? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  // Snapshot of the file/uploader at the time the case was opened, so the
  // record remains meaningful regardless of what later happens to either.
  fileTitleSnapshot    String
  fileFilenameSnapshot String
  fileHashSnapshot     String?
  uploaderId           Int?
  uploaderNameSnapshot String?
  uploaderUsernameSnapshot String?

  complainantUserId Int?
  complainantUser   User?   @relation("ReportComplainant", fields: [complainantUserId], references: [id], onDelete: SetNull)
  complainantName   String
  complainantEmail  String
  complainantPhone  String?

  copyrightedWork     String
  infringingLocation  String?
  explanation         String
  ownershipEvidence   String?
  supportingInfo      String?
  declarationAccepted Boolean @default(false)

  status  CopyrightReportStatus   @default(PENDING)
  outcome CopyrightReportOutcome?
  reason  String?
  decision   String?
  actionTaken String?

  // Admin-editable case-record fields that the backend has no automatic
  // way of knowing — e.g. the uploader was notified by email outside the
  // system, or responded outside the system. Per-case (not on File),
  // since a single file can have more than one report/case.
  uploaderNotifiedAt DateTime?
  uploaderResponse   String?

  reviewedByUserId Int?
  reviewedByUser   User?     @relation("ReportReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fileId])
  @@index([status])
  @@index([createdAt])
  @@index([caseNumber])
}

// An uploader's counter-notice against a RESTRICTED/REMOVED file.
model CopyrightDispute {
  id     Int  @id @default(autoincrement())
  fileId Int
  file   File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  uploaderId Int
  uploader   User @relation("DisputeUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  explanation      String
  ownsWork         Boolean @default(false)
  hasPermission    Boolean @default(false)
  otherLawfulBasis String?

  status        CopyrightDisputeStatus @default(PENDING)
  adminResponse String?

  reviewedByUserId Int?
  reviewedByUser   User?     @relation("DisputeReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fileId])
  @@index([uploaderId])
  @@index([status])
}

// Internal-only admin reasoning/evidence, never shown to students.
model CopyrightNote {
  id     Int  @id @default(autoincrement())
  fileId Int
  file   File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  authorId Int
  author   User @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  note      String
  createdAt DateTime @default(now())

  @@index([fileId, createdAt])
}

// Immutable trail of every copyright-moderation action. Never editable by
// ordinary users — only ever inserted into, from admin controllers.
model CopyrightAuditLog {
  id      Int  @id @default(autoincrement())
  adminId Int
  admin   User @relation("AuditAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  action         String
  targetFileId   Int?
  targetUserId   Int?
  targetUser     User?   @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  reportId       Int?
  disputeId      Int?
  reason         String?
  previousStatus String?
  newStatus      String?

  createdAt DateTime @default(now())

  @@index([targetFileId])
  @@index([targetUserId])
  @@index([createdAt])
}

model FlashcardSet {
  id           Int         @id @default(autoincrement())
  title        String
  difficulty   String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  lastPracticeScore Int?
  lastPracticeCount Int?
  lastPracticedAt DateTime?

  userId       Int
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // When generated for a Study Circle, this set is also visible to the
  // whole circle. Null means it's a personal set only.
  circleId     Int?
  circle       StudyCircle? @relation(fields: [circleId], references: [id], onDelete: SetNull)

  flashcards   Flashcard[]
}

model Flashcard {
  id               Int             @id @default(autoincrement())
  front            String
  back             String
  createdAt        DateTime        @default(now())

  // --- Spaced repetition (SM-2) ---
  // easeFactor/intervalDays/repetitions follow the classic SM-2 algorithm.
  // dueDate is when the card next becomes eligible for review; a card with
  // no review history is due immediately (defaults to creation time).
  easeFactor       Float           @default(2.5)
  intervalDays     Int             @default(0)
  repetitions      Int             @default(0)
  dueDate          DateTime        @default(now())
  lastReviewedAt   DateTime?
  lastRating       String?         // "again" | "hard" | "good" | "easy"

  flashcardSetId   Int
  flashcardSet     FlashcardSet    @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)

  @@index([flashcardSetId])
  @@index([dueDate])
}

// ---------------------------------------------------------------------
// Study Circles
// ---------------------------------------------------------------------

model StudyCircle {
  id          Int      @id @default(autoincrement())
  name        String
  courseCode  String?
  description String?
  visibility  String   @default("PRIVATE") // "PUBLIC" | "PRIVATE"
  joinCode    String   @unique
  joinCodeEnabled Boolean @default(true)
  joinCodeExpiresAt DateTime?
  joinCodeMaxUses Int?
  joinCodeUses Int @default(0)
  joinCodeVersion Int @default(1)
  joinCodeRegeneratedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId     Int
  owner       User     @relation("CircleOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members       CircleMember[]
  invites       CircleInvite[]
  joinRequests  CircleJoinRequest[]
  messages      CircleMessage[]
  sharedFiles   CircleSharedFile[]
  flashcardSets FlashcardSet[]
  invitationLinks CircleInvitationLink[]
  notifications Notification[]
  pinnedMessages CirclePinnedMessage[]

  studySessions StudySession[]
  notes         CircleNote[]
}

model CircleMember {
  id       Int      @id @default(autoincrement())
  role     String   @default("MEMBER") // "OWNER" | "MODERATOR" | "MEMBER"
  joinedAt DateTime @default(now())

  circleId Int
  circle   StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  userId   Int
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId])
}

// Owner/moderator-sent invites to a specific username. Used for Private
// circles, alongside the shareable join code.
model CircleInvite {
  id        Int      @id @default(autoincrement())
  status    String   @default("PENDING") // "PENDING" | "ACCEPTED" | "DECLINED"
  createdAt DateTime @default(now())

  circleId  Int
  circle    StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  invitedUserId Int
  invitedUser   User @relation("CircleInvitesReceived", fields: [invitedUserId], references: [id], onDelete: Cascade)

  invitedByUserId Int
  invitedByUser   User @relation("CircleInvitesSent", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([invitedUserId, status])
}

// A user requesting to join a Public circle, approved/declined by the
// owner or a moderator.
model CircleJoinRequest {
  id        Int      @id @default(autoincrement())
  status    String   @default("PENDING") // "PENDING" | "APPROVED" | "DECLINED"
  createdAt DateTime @default(now())

  circleId  Int
  circle    StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  userId    Int
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([circleId, status])
}

model CircleMessage {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  circleId  Int
  circle    StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  userId    Int
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedByUserId Int?
  deletedByUser User? @relation("CircleMessageDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)

  pinnedMessage CirclePinnedMessage?
  notifications Notification[]

  @@index([circleId, createdAt])
  @@index([circleId, id])
}

// Links an existing uploaded File into a circle's shared materials list.
model CircleSharedFile {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  circleId  Int
  circle    StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  fileId    Int
  file      File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  sharedByUserId Int
  sharedByUser   User @relation("CircleFilesShared", fields: [sharedByUserId], references: [id], onDelete: Cascade)

  @@unique([circleId, fileId])
}


model CirclePinnedMessage {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  circleId  Int
  circle    StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  messageId Int      @unique
  message   CircleMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  pinnedByUserId Int
  pinnedByUser User @relation(fields: [pinnedByUserId], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt])
}

model CircleInvitationLink {
  id            Int      @id @default(autoincrement())
  tokenHash     String   @unique
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  maxUses       Int?
  uses          Int      @default(0)
  joinCodeVersion Int

  circleId      Int
  circle        StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

}

// Lightweight session scheduling for a circle ("study session Thursday
// 7pm"). Members can RSVP; the creator (owner/moderator) can edit or
// cancel.
model StudySession {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  location        String?
  scheduledFor    DateTime
  durationMinutes Int      @default(60)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  circleId        Int
  circle          StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  createdByUserId Int
  createdByUser   User @relation("StudySessionCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  rsvps           StudySessionRSVP[]

  @@index([circleId, scheduledFor])
}

model StudySessionRSVP {
  id        Int      @id @default(autoincrement())
  status    String   @default("GOING") // "GOING" | "MAYBE" | "DECLINED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionId Int
  session   StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId    Int
  user      User @relation("StudySessionRSVPUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

// Lightweight shared notes/wiki for a circle — a small set of named notes
// any member can create or edit, so useful info doesn't get buried in
// chat scrollback.
model CircleNote {
  id              Int      @id @default(autoincrement())
  title           String
  content         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  circleId        Int
  circle          StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  createdByUserId Int
  createdByUser   User @relation("CircleNoteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  updatedByUserId Int?
  updatedByUser   User? @relation("CircleNoteUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([circleId, updatedAt])
}

// A single browser/device's Firebase Cloud Messaging registration. A user
// may be signed in on several browsers/devices at once, so this is a
// one-to-many relation to User rather than a single token column on User.
model PushRegistration {
  id     Int    @id @default(autoincrement())
  // The current FCM registration token for this browser/device. Unique
  // because FCM issues one token per app-instance; re-registering the same
  // token (e.g. token refresh with no real change) upserts in place instead
  // of creating a duplicate row.
  token  String @unique

  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Free-text device/browser label (e.g. "Chrome on Windows"), best-effort
  // from the client's user agent — never anything sensitive.
  deviceInfo String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // Bumped whenever a push is successfully delivered to this token, and
  // whenever the client re-confirms the registration is still current.
  lastUsedAt DateTime @default(now())

  // Flipped to false (rather than deleted immediately) when FCM reports the
  // token as invalid/unregistered, so a brief delivery failure doesn't
  // silently drop a device — see pushNotificationService for cleanup.
  active Boolean @default(true)

  @@index([userId])
  @@index([userId, active])
}

model Notification {
  id          Int      @id @default(autoincrement())
  type        String
  title       String
  body        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  userId      Int
  user        User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  actorUserId Int?
  actorUser   User?    @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  circleId    Int?
  circle      StudyCircle? @relation(fields: [circleId], references: [id], onDelete: Cascade)

  messageId   Int?
  message     CircleMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  groupKey    String? @unique

  @@index([userId, createdAt])
  @@index([userId, read, createdAt])
}
