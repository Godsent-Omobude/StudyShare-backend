datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  username  String   @unique
  email     String?  @unique
  matricNumber String?
  password  String
  role      String   @default("student")
  profilePicture String?
  showUsernameOnMaterials Boolean @default(true)
  theme     String   @default("system")
  accentColor String  @default("blue")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?
  tokenVersion Int @default(0)
  emailVerified Boolean @default(false)
  verificationCodeHash String?
  verificationCodeExpiresAt DateTime?
  verificationAttempts Int @default(0)
  verificationCodeSentAt DateTime?
  currentStreak Int @default(0)
  longestStreak Int @default(0)
  lastStudyDate DateTime?
  totalStudyDays Int @default(0)
  // Hash of the card-id order from this user's most recent "Study All"
  // shuffle. Used purely so a freshly generated shuffle can be checked
  // against it and re-rolled on the rare collision — no AI involved.
  lastShuffleHash String?
  files     File[]
  flashcardSets FlashcardSet[]

  ownedCircles          StudyCircle[]       @relation("CircleOwner")
  circleMemberships     CircleMember[]
  circleInvitesSent     CircleInvite[]      @relation("CircleInvitesSent")
  circleInvitesReceived CircleInvite[]      @relation("CircleInvitesReceived")
  circleJoinRequests    CircleJoinRequest[]
  circleMessages        CircleMessage[]
  circleFilesShared     CircleSharedFile[] @relation("CircleFilesShared")
  deletedCircleMessages CircleMessage[]    @relation("CircleMessageDeletedBy")
  notificationsReceived Notification[]      @relation("NotificationRecipient")
  notificationsCreated Notification[]      @relation("NotificationActor")
  pinnedCircleMessages CirclePinnedMessage[]

  studySessionsCreated StudySession[]       @relation("StudySessionCreator")
  studySessionRsvps    StudySessionRSVP[]   @relation("StudySessionRSVPUser")
  circleNotesCreated   CircleNote[]         @relation("CircleNoteCreator")
  circleNotesUpdated   CircleNote[]         @relation("CircleNoteUpdater")
}

model File {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  courseCode   String?
  type         String   // 'Material' or 'Past Question'
  filename     String
  filepath     String
  mimetype     String
  uploaderName String
  downloads    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relationship to User
  uploadedBy   Int
  user         User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  circleShares CircleSharedFile[]
}

model FlashcardSet {
  id           Int         @id @default(autoincrement())
  title        String
  difficulty   String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  lastPracticeScore Int?
  lastPracticeCount Int?
  lastPracticedAt DateTime?

  userId       Int
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // When generated for a Study Circle, this set is also visible to the
  // whole circle. Null means it's a personal set only.
  circleId     Int?
  circle       StudyCircle? @relation(fields: [circleId], references: [id], onDelete: SetNull)

  flashcards   Flashcard[]
}

model Flashcard {
  id               Int             @id @default(autoincrement())
  front            String
  back             String
  createdAt        DateTime        @default(now())

  // --- Spaced repetition (SM-2) ---
  // easeFactor/intervalDays/repetitions follow the classic SM-2 algorithm.
  // dueDate is when the card next becomes eligible for review; a card with
  // no review history is due immediately (defaults to creation time).
  easeFactor       Float           @default(2.5)
  intervalDays     Int             @default(0)
  repetitions      Int             @default(0)
  dueDate          DateTime        @default(now())
  lastReviewedAt   DateTime?
  lastRating       String?         // "again" | "hard" | "good" | "easy"

  flashcardSetId   Int
  flashcardSet     FlashcardSet    @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)

  @@index([flashcardSetId])
  @@index([dueDate])
}

// ---------------------------------------------------------------------
// Study Circles
// ---------------------------------------------------------------------

model StudyCircle {
  id          Int      @id @default(autoincrement())
  name        String
  courseCode  String?
  description String?
  visibility  String   @default("PRIVATE") // "PUBLIC" | "PRIVATE"
  joinCode    String   @unique
  joinCodeEnabled Boolean @default(true)
  joinCodeExpiresAt DateTime?
  joinCodeMaxUses Int?
  joinCodeUses Int @default(0)
  joinCodeVersion Int @default(1)
  joinCodeRegeneratedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId     Int
  owner       User     @relation("CircleOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members       CircleMember[]
  invites       CircleInvite[]
  joinRequests  CircleJoinRequest[]
  messages      CircleMessage[]
  sharedFiles   CircleSharedFile[]
  flashcardSets FlashcardSet[]
  invitationLinks CircleInvitationLink[]
  notifications Notification[]
  pinnedMessages CirclePinnedMessage[]

  studySessions StudySession[]
  notes         CircleNote[]
}

model CircleMember {
  id       Int      @id @default(autoincrement())
  role     String   @default("MEMBER") // "OWNER" | "MODERATOR" | "MEMBER"
  joinedAt DateTime @default(now())

  circleId Int
  circle   StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  userId   Int
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId])
}

// Owner/moderator-sent invites to a specific username. Used for Private
// circles, alongside the shareable join code.
model CircleInvite {
  id        Int      @id @default(autoincrement())
  status    String   @default("PENDING") // "PENDING" | "ACCEPTED" | "DECLINED"
  createdAt DateTime @default(now())

  circleId  Int
  circle    StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  invitedUserId Int
  invitedUser   User @relation("CircleInvitesReceived", fields: [invitedUserId], references: [id], onDelete: Cascade)

  invitedByUserId Int
  invitedByUser   User @relation("CircleInvitesSent", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([invitedUserId, status])
}

// A user requesting to join a Public circle, approved/declined by the
// owner or a moderator.
model CircleJoinRequest {
  id        Int      @id @default(autoincrement())
  status    String   @default("PENDING") // "PENDING" | "APPROVED" | "DECLINED"
  createdAt DateTime @default(now())

  circleId  Int
  circle    StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  userId    Int
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([circleId, status])
}

model CircleMessage {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  circleId  Int
  circle    StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  userId    Int
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedByUserId Int?
  deletedByUser User? @relation("CircleMessageDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)

  pinnedMessage CirclePinnedMessage?
  notifications Notification[]

  @@index([circleId, createdAt])
  @@index([circleId, id])
}

// Links an existing uploaded File into a circle's shared materials list.
model CircleSharedFile {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  circleId  Int
  circle    StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  fileId    Int
  file      File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  sharedByUserId Int
  sharedByUser   User @relation("CircleFilesShared", fields: [sharedByUserId], references: [id], onDelete: Cascade)

  @@unique([circleId, fileId])
}


model CirclePinnedMessage {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  circleId  Int
  circle    StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  messageId Int      @unique
  message   CircleMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  pinnedByUserId Int
  pinnedByUser User @relation(fields: [pinnedByUserId], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt])
}

model CircleInvitationLink {
  id            Int      @id @default(autoincrement())
  tokenHash     String   @unique
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  maxUses       Int?
  uses          Int      @default(0)
  joinCodeVersion Int

  circleId      Int
  circle        StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

}

// Lightweight session scheduling for a circle ("study session Thursday
// 7pm"). Members can RSVP; the creator (owner/moderator) can edit or
// cancel.
model StudySession {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  location        String?
  scheduledFor    DateTime
  durationMinutes Int      @default(60)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  circleId        Int
  circle          StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  createdByUserId Int
  createdByUser   User @relation("StudySessionCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  rsvps           StudySessionRSVP[]

  @@index([circleId, scheduledFor])
}

model StudySessionRSVP {
  id        Int      @id @default(autoincrement())
  status    String   @default("GOING") // "GOING" | "MAYBE" | "DECLINED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionId Int
  session   StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId    Int
  user      User @relation("StudySessionRSVPUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

// Lightweight shared notes/wiki for a circle — a small set of named notes
// any member can create or edit, so useful info doesn't get buried in
// chat scrollback.
model CircleNote {
  id              Int      @id @default(autoincrement())
  title           String
  content         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  circleId        Int
  circle          StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  createdByUserId Int
  createdByUser   User @relation("CircleNoteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  updatedByUserId Int?
  updatedByUser   User? @relation("CircleNoteUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([circleId, updatedAt])
}

model Notification {
  id          Int      @id @default(autoincrement())
  type        String
  title       String
  body        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  userId      Int
  user        User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  actorUserId Int?
  actorUser   User?    @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  circleId    Int?
  circle      StudyCircle? @relation(fields: [circleId], references: [id], onDelete: Cascade)

  messageId   Int?
  message     CircleMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  groupKey    String? @unique

  @@index([userId, createdAt])
  @@index([userId, read, createdAt])
}
